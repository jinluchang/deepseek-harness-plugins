{
  "name": "dsh-llm-api-call-tuning",
  "version": "0.2.2-alpha.2",
  "private": false,
  "type": "module",
  "description": "One settings page that tunes every model API call: the global retry-policy defaults (mode, max retries, backoff delays, jitter, and retryable failure codes), the two process-wide HTTP fetch timeouts (response headers and response body), and the per-route provider timeouts (stream idle watchdog, SDK request timeout, and Files API timeout).",
  "author": {
    "name": "Luchang Jin",
    "email": "ljin.luchang@gmail.com"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinluchang/deepseek-harness-plugins.git",
    "directory": "dsh-llm-api-call-tuning"
  },
  "homepage": "https://github.com/jinluchang/deepseek-harness-plugins/tree/main/dsh-llm-api-call-tuning",
  "bugs": { "url": "https://github.com/jinluchang/deepseek-harness-plugins/issues" },
  "engines": { "dsh": "^0.2.2-alpha.2" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "verify.mjs",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "scripts": {
    "verify": "node verify.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
