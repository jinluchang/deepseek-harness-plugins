{
  "name": "dsh-backend-restart",
  "version": "0.2.1-rc.3",
  "private": false,
  "type": "module",
  "description": "Settings-page action that restarts the DSH backend process.",
  "author": {
    "name": "Luchang Jin",
    "email": "ljin.luchang@gmail.com"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinluchang/deepseek-harness-plugins.git",
    "directory": "dsh-backend-restart"
  },
  "homepage": "https://github.com/jinluchang/deepseek-harness-plugins/tree/main/dsh-backend-restart",
  "bugs": { "url": "https://github.com/jinluchang/deepseek-harness-plugins/issues" },
  "engines": { "dsh": "^0.2.1-rc.3" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "restart-helper.js",
    "client.js",
    "verify.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "CONTRACT.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
