{
  "name": "dsh-compaction-tuner",
  "version": "0.2.1-rc.3",
  "private": false,
  "type": "module",
  "description": "One settings page that tunes compaction-basic for every agent preset in the active profile.",
  "author": {
    "name": "Luchang Jin",
    "email": "ljin.luchang@gmail.com"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinluchang/deepseek-harness-plugins.git",
    "directory": "dsh-compaction-tuner"
  },
  "homepage": "https://github.com/jinluchang/deepseek-harness-plugins/tree/main/dsh-compaction-tuner",
  "bugs": { "url": "https://github.com/jinluchang/deepseek-harness-plugins/issues" },
  "engines": { "dsh": "^0.2.1-rc.3" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "verify.mjs",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "scripts": {
    "verify": "node verify.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
